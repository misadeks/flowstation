[Unit]
Description=FlowStation WAP 1.x gateway
Documentation=https://github.com/misadeks/flowstation
After=network.target

[Service]
Type=simple
ExecStart=/usr/local/bin/flowstation-wap-gateway --config /etc/flowstation/wap-gateway-config.toml
WorkingDirectory=/home/pi
Restart=on-failure
RestartSec=5s
# Needs to bind a UDP socket on a low-ish port. 9201 is unprivileged so no
# extra capabilities are required.

[Install]
WantedBy=multi-user.target
